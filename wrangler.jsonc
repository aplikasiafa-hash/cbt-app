{
  // =====================================================================
  //  CBT Sekolah — konfigurasi Cloudflare (paket GRATIS)
  //  Repo GitHub ini (cbt-app) dihubungkan ke Cloudflare Workers Builds:
  //  setiap commit ke branch "main" otomatis dipasang ulang.
  // =====================================================================
  "$schema": "node_modules/wrangler/config-schema.json",

  // Nama Worker. HARUS sama dengan nama Worker di dashboard Cloudflare.
  "name": "cbt-sekolah",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,

  // Aplikasi guru & siswa (HTML) — aset statis, gratis & tidak dihitung kuota
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // HEMAT KUOTA: hanya /api yang membangunkan Worker. Alamat lain (bot pemindai seperti /wp-admin,
    // /.env, dll.) dijawab 404.html oleh lapisan aset tanpa dihitung sebagai request Worker.
    "not_found_handling": "404-page",
    // /ujian-cbt/* lewat Worker agar bisa diperiksa: hanya aplikasi CBT Ujian yang boleh membukanya.
    "run_worker_first": ["/api", "/api/*", "/ujian-cbt", "/ujian-cbt/*"]
  },

  // Database D1 "cbt-sekolah-db". Dibuat OTOMATIS saat pemasangan pertama.
  // Bila Anda membuatnya manual di dashboard, hapus tanda // di depan database_id
  // lalu tempel Database ID-nya.
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cbt-sekolah-db"
    // , "database_id": "TEMPEL-DATABASE-ID-DI-SINI"
  }],

  // Mesin ujian (sesi langsung + WebSocket). Paket gratis wajib kelas SQLite.
  "durable_objects": { "bindings": [{ "name": "ENGINE", "class_name": "Engine" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Engine"] }],

  // Perawatan harian pukul 00.00 WITA (= 16.00 UTC): hasil yang belum tersimpan dikirim ke database, sesi ujian
  // yang sudah selesai dibereskan dari penyimpanan internal, dan cadangan serverB dikirim — HANYA bila ada perubahan.
  // Selama ujian, mesin ujian merawat dirinya sendiri; di luar jam ujian ia tidur (tidak memakai kuota).
  "triggers": { "crons": ["0 16 * * *"] },

  // Setelan khusus tiap sekolah TIDAK ditulis di sini, tetapi di dashboard serverC:
  // Workers & Pages → (Worker sekolah) → Settings → Variables and Secrets → Add
  //   Text   MEDIA_REPO     akun-github-sekolah/cbt-media   (repo PUBLIK untuk gambar soal)
  //   Text   DATA_REPO      akun-github-sekolah/cbt-data    (repo PRIVAT untuk cadangan soal & hasil)
  //   Text   CF_ACCOUNT_ID  ID akun serverC sekolah          (untuk panel Penggunaan harian)
  //   Secret GITHUB_TOKEN   token github_pat_…
  //   Secret CF_API_TOKEN   token API serverC (opsional)
  // keep_vars = true: setiap pemasangan ulang dari GitHub TIDAK menghapus/menimpa isian dashboard di atas,
  // jadi berkas repo ini aman diunggah ke repo sekolah mana pun.
  "keep_vars": true,
  "vars": {
    "BRANCH": "main",
    "MEDIA_CDN": "jsdelivr"
  },

  "observability": { "enabled": true, "head_sampling_rate": 0.05 }
}
